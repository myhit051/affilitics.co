# Affilitics.co - Production Environment Variables for Coolify
# Copy this to .env.production and fill in your actual values

# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://your-domain.com

# ===========================================
# Supabase Configuration
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE=your-service-role-key
SUPABASE_STORAGE_BUCKET=affilitics-uploads

# ===========================================
# Database Configuration
# ===========================================
DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# ===========================================
# Monitoring & Observability
# ===========================================
ENABLE_METRICS=true
ERROR_REPORTING=true
LOG_LEVEL=info

# Alert Webhooks (Slack, Discord, etc.)
ALERT_WEBHOOKS=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ===========================================
# Worker Service Configuration
# ===========================================
MAX_CONCURRENT_JOBS=10
MAX_QUEUE_SIZE=1000
MEMORY_WARNING_THRESHOLD=0.75
MEMORY_CRITICAL_THRESHOLD=0.90
HEALTH_CHECK_INTERVAL=60000

# ===========================================
# Performance Tuning
# ===========================================
NODE_OPTIONS=--max_old_space_size=4096
NEXT_TELEMETRY_DISABLED=1

# ===========================================
# Security (Optional)
# ===========================================
# JWT_SECRET=your-jwt-secret
# ENCRYPTION_KEY=your-encryption-key
